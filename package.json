{
  "name": "c-emprende504-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para el sitio principal y futuros micrositios de C-Emprende504",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@c-emprende504/main",
    "build": "npm run build --workspace=@c-emprende504/main",
    "preview": "npm run preview --workspace=@c-emprende504/main",
    "check": "npm run check --workspace=@c-emprende504/main"
  }
}
