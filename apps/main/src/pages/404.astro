---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página a la que intentas acceder no está disponible o ha sido movida dentro de la plataforma C-Emprende504."
  noindex={true}
  nofollow={true}
>
  <div class="section not-found-section">
    <div class="container container-narrow">
      <div class="not-found-card">
        <span class="error-code" aria-hidden="true">404</span>
        <span class="eyebrow-tag">Error de Navegación</span>
        <h1>Página no encontrada</h1>
        <p class="lead">
          Lo sentimos, la página que intentas visitar no existe, ha cambiado de dirección o se encuentra en fase de reestructuración técnica.
        </p>

        <div class="not-found-actions">
          <Button href="/" variant="primary">
            Volver al Inicio
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </Button>
          <Button href="/#nichos" variant="outline">
            Explorar Nichos en Planificación
          </Button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-section {
    min-height: calc(100vh - var(--header-height) - 280px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .not-found-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    text-align: center;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .not-found-card {
      padding: var(--space-12) var(--space-10);
    }
  }

  .error-code {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 900;
    line-height: 1;
    color: var(--color-surface-subtle);
    margin-bottom: var(--space-2);
    letter-spacing: -0.05em;
    user-select: none;
  }

  .eyebrow-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    background-color: var(--color-primary-subtle);
    border: 1px solid var(--color-primary-border);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  @media (min-width: 640px) {
    h1 {
      font-size: var(--text-3xl);
    }
  }

  .lead {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .lead {
      font-size: var(--text-lg);
    }
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
