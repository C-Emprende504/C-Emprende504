---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'C-Emprende504 — Plataforma central para el impulso y descubrimiento de habilidades digitales.',
  canonical,
  noindex = false,
  nofollow = false,
  ogType = 'website',
} = Astro.props;

// Nota técnica SEO: Se evita emitir una URL canónica fija mientras no exista un dominio definitivo configurado en Astro.site.
const canonicalURL = canonical || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);
const pageTitle = `${title} | C-Emprende504`;

// Control centralizado de indexación para el dominio temporal:
// Mientras no exista un dominio oficial configurado en Astro.site:
// - Páginas públicas: 'noindex, follow' (permite el rastreo de enlaces pero evita indexar el dominio técnico .pages.dev).
// - Página 404 / error: 'noindex, nofollow' (aislamiento total de rutas no encontradas).
// Cuando se declare el dominio definitivo en astro.config.mjs (Astro.site definido),
// las páginas públicas conmutarán automáticamente a 'index, follow'.
const hasOfficialDomain = Boolean(Astro.site);
const robotsDirective = (noindex || nofollow)
  ? 'noindex, nofollow'
  : hasOfficialDomain
    ? 'index, follow'
    : 'noindex, follow';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Metadatos Básicos y SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph Básico -->
    <meta property="og:site_name" content="C-Emprende504" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_HN" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <!-- Twitter Card Básico -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Control de Indexación -->
    <meta name="robots" content={robotsDirective} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <Header currentPath={Astro.url.pathname} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
