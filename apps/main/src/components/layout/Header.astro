---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/#nichos', label: 'Nichos' },
  { href: '/about', label: 'Acerca de' },
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href === '/about' && currentPath === '/about') return true;
  return false;
};
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="C-Emprende504 - Portal Principal">
      <span class="brand-text">C-Emprende<span class="brand-accent">504</span></span>
      <span class="brand-badge" aria-label="Versión preliminar">Portal</span>
    </a>

    <button
      type="button"
      id="mobile-nav-toggle"
      class="mobile-toggle"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Abrir menú de navegación"
    >
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li class="nav-item">
              <a
                href={item.href}
                class={`nav-link ${isActive(item.href) ? 'active' : ''}`.trim()}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="header-cta">
        <a href="/#nichos" class="cta-link">
          Ver Nichos
          <span class="cta-dot" aria-hidden="true"></span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: rgba(11, 11, 11, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  @media (min-width: 640px) {
    .brand-link {
      font-size: var(--text-xl);
    }
  }

  .brand-accent {
    color: var(--color-primary);
  }

  .brand-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--color-surface);
    color: var(--color-primary);
    border: 1px solid var(--color-primary-border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    margin: 0;
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-subtle);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-text);
    font-weight: 600;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .header-cta {
    display: flex;
    align-items: center;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: border-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cta-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
    box-shadow: 0 0 12px rgba(255, 90, 0, 0.2);
  }

  .cta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  /* Botón hamburguesa accesible para móvil */
  .mobile-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    cursor: pointer;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    color: var(--color-text);
  }

  .toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 1px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  @media (max-width: 767px) {
    .mobile-toggle {
      display: flex;
    }

    .primary-nav {
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background-color: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-6) var(--space-4);
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      box-shadow: var(--shadow-lg);
    }

    .primary-nav.is-open {
      display: flex;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }

    .nav-link {
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-base);
    }

    .header-cta {
      justify-content: center;
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
    }

    .cta-link {
      width: 100%;
      justify-content: center;
      padding: var(--space-3);
    }
  }
</style>

<script>
  // Control accesible del menú móvil
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const navMenu = document.getElementById('primary-navigation');

  if (toggleBtn && navMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      navMenu.classList.toggle('is-open', !isExpanded);
      toggleBtn.setAttribute(
        'aria-label',
        isExpanded ? 'Abrir menú de navegación' : 'Cerrar menú de navegación'
      );
    });

    // Cerrar menú al presionar Escape o al hacer clic en un enlace
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navMenu.classList.contains('is-open')) {
        navMenu.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.focus();
      }
    });

    navMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (navMenu.classList.contains('is-open')) {
          navMenu.classList.remove('is-open');
          toggleBtn.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }
</script>
