---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/about', label: 'Acerca de' },
  { href: '/contact', label: 'Contacto' },
  { href: '/affiliate-disclosure', label: 'Aviso de Afiliación' },
  { href: '/privacy', label: 'Privacidad' },
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="C-Emprende504 - Página Principal">
      <span class="brand-text">C-Emprende<span class="brand-accent">504</span></span>
      <span class="env-tag">Dev</span>
    </a>

    <button
      type="button"
      id="mobile-nav-toggle"
      class="mobile-toggle"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Abrir menú de navegación"
    >
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li class="nav-item">
              <a
                href={item.href}
                class={`nav-link ${isActive(item.href) ? 'active' : ''}`.trim()}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .brand-accent {
    color: var(--color-primary);
  }

  .env-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    background-color: var(--color-surface-subtle);
    color: var(--color-text-subtle);
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    text-transform: uppercase;
  }

  .primary-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    margin: 0;
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-subtle);
  }

  .nav-link.active {
    color: var(--color-primary);
    font-weight: 600;
    background-color: var(--color-primary-light);
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    cursor: pointer;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }

  .toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 1px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  @media (max-width: 767px) {
    .mobile-toggle {
      display: flex;
    }

    .primary-nav {
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background-color: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-4);
      display: none;
      box-shadow: var(--shadow-md);
    }

    .primary-nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }

    .nav-link {
      padding: var(--space-3);
      font-size: var(--text-base);
    }
  }
</style>

<script>
  // Script accesible y sin dependencias para el menú de navegación móvil
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const navMenu = document.getElementById('primary-navigation');

  if (toggleBtn && navMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      navMenu.classList.toggle('is-open', !isExpanded);
      toggleBtn.setAttribute(
        'aria-label',
        isExpanded ? 'Abrir menú de navegación' : 'Cerrar menú de navegación'
      );
    });

    // Cerrar al presionar Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navMenu.classList.contains('is-open')) {
        navMenu.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.focus();
      }
    });
  }
</script>
