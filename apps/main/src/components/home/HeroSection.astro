---
import Button from '../ui/Button.astro';
---

<section class="hero-section" aria-labelledby="hero-title">
  <!-- Resplandor decorativo de fondo -->
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span class="pill-text">Ecosistema Multi-Sitio en Desarrollo</span>
      </div>

      <h1 class="hero-title" id="hero-title">
        Plataforma Central para el Impulso de <span class="highlight-orange">Habilidades Digitales</span>
      </h1>

      <p class="hero-description">
        C-Emprende504 es el portal matriz diseñado para articular y dar acceso a futuros micrositios especializados en formación, autoempleo y crecimiento profesional por áreas de nicho.
      </p>

      <div class="hero-actions">
        <Button href="#nichos" variant="primary">
          Explorar Nichos
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
        </Button>
        <Button href="/about" variant="outline">
          Acerca de la Plataforma
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background-color: var(--color-bg);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .hero-section {
      padding-top: var(--space-20);
      padding-bottom: var(--space-20);
    }
  }

  /* Resplandor naranja difuso en la parte superior central */
  .hero-glow {
    position: absolute;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 90, 0, 0.15) 0%, rgba(11, 11, 11, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.375rem 0.875rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary);
  }

  .pill-text {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: -0.03em;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: var(--text-4xl);
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }

  .highlight-orange {
    color: var(--color-primary);
    background: linear-gradient(135deg, #ff5a00 0%, #ff8533 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .hero-description {
      font-size: var(--text-lg);
    }
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: 0;
  }
</style>
