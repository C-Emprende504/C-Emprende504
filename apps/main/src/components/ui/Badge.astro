---
interface Props {
  variant?: 'planning' | 'preparation' | 'accent' | 'default';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;
---

<span class={`badge badge-${variant} ${className}`.trim()}>
  <span class="badge-dot" aria-hidden="true"></span>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.25rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  /* Variante En Planificación */
  .badge-planning {
    background-color: var(--color-status-planning-bg);
    color: var(--color-status-planning-text);
    border-color: var(--color-status-planning-border);
  }

  .badge-planning .badge-dot {
    background-color: var(--color-primary);
  }

  /* Variante En Preparación */
  .badge-preparation {
    background-color: var(--color-status-prep-bg);
    color: var(--color-status-prep-text);
    border-color: var(--color-status-prep-border);
  }

  .badge-preparation .badge-dot {
    background-color: #a1a1aa;
  }

  /* Variante Acento */
  .badge-accent {
    background-color: var(--color-primary-subtle);
    color: var(--color-primary);
    border-color: var(--color-primary-border);
  }

  .badge-accent .badge-dot {
    background-color: var(--color-primary);
  }

  /* Variante Default */
  .badge-default {
    background-color: var(--color-surface-subtle);
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .badge-default .badge-dot {
    background-color: var(--color-text-subtle);
  }
</style>
